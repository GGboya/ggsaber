{
  "server": {
    "port": ":8080",
    "mode": "release"
  },
  "database": {
    "host": "postgres",
    "port": 5432,
    "user": "postgres",
    "password": "your_password_here",
    "dbname": "go_saber",
    "sslmode": "disable"
  },
  "redis": {
    "addr": "redis:6379",
    "password": "",
    "db": 0
  },
  "jwt": {
    "secret": "your_jwt_secret_here",
    "expire_hours": 24
  },
  "cors": {
    "allowed_origins": ["https://your-domain.com", "https://www.your-domain.com"],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization"],
    "expose_headers": ["Content-Length"],
    "allow_credentials": true,
    "max_age": 12
  },
  "judge": {
    "time_limit": 5000,
    "memory_limit": 256,
    "temp_dir": "/tmp"
  },
  "match": {
    "check_interval": 2,
    "max_wait_time": 300
  },
  "log": {
    "level": "info",
    "file": "/root/logs/app.log",
    "max_size": 100,
    "max_age": 30,
    "max_backups": 10
  }
} 